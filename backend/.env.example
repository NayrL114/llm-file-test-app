# backend/.env.example
# Copy this file to `backend/.env` and fill in your keys before running the server.

# Required
# Set these to enable OpenAI provider, Google Gemini provider, and Anthropic Claude provider respectively.
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY
GOOGLE_API_KEY=AIzaREPLACE_WITH_YOUR_GOOGLE_API_KEY
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_ANTHROPIC_KEY

# Optional: override provider model names (change only if you know what you're doing)
# If unset, defaults used by the server are: OPENAI_CHAT_MODEL=gpt-5.2, GOOGLE_MODEL=gemini-2.5-flash, ANTHROPIC_MODEL=claude-2.1
OPENAI_CHAT_MODEL=gpt-5.2
GOOGLE_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Notes:
# - The backend uses `fetch` for provider APIs. Node 18+ supplies a global `fetch`; if your Node runtime
#   does not provide it, install a compatible polyfill (e.g., `node-fetch`) or upgrade Node.
# - Keep your API keys secret (do not commit `backend/.env` into source control).
# - Restart the backend after changing these values.
